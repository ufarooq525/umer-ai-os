{
  "name": "umer-ai-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "dev:infra": "docker compose -f infra/docker/docker-compose.yml up -d",
    "dev:infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:build": "node scripts/docker-build.mjs",
    "prod:up": "docker compose -f infra/docker/docker-compose.yml --profile apps up -d --build",
    "prod:down": "docker compose -f infra/docker/docker-compose.yml --profile apps down",
    "helm:lint": "helm lint infra/k8s/charts/umer-ai-os",
    "helm:template": "helm template umer infra/k8s/charts/umer-ai-os",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm --filter @umer/contracts run build && pnpm -r run typecheck",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "opportunity:test": "vitest run packages/opportunity-intelligence/src/e2e-mysql-flow.test.ts",
    "clean": "pnpm -r run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:migrate": "pnpm --filter @umer/db migrate",
    "db:seed": "pnpm --filter @umer/db seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@umer/agent-runtime": "workspace:*",
    "@umer/artifacts": "workspace:*",
    "@umer/contracts": "workspace:*",
    "@umer/message-fabric": "workspace:*",
    "@umer/memory-access": "workspace:*",
    "@umer/trust": "workspace:*",
    "@umer/audit": "workspace:*",
    "@umer/orchestration": "workspace:*",
    "@umer/specialist-sdk": "workspace:*",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
