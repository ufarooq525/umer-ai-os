# Umer AI OS — local / deploy environment template
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://umer:umer@localhost:5432/umer_ai_os
# Dedicated MySQL persistence for Opportunity Intelligence / Revenue OS
OPPORTUNITY_DATABASE_URL=mysql://umer_revenue:umer_revenue@localhost:3306/umer_revenue_os
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_ARTIFACTS=umer-artifacts
S3_FORCE_PATH_STYLE=true

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=umer-ai-os

CONTROL_API_PORT=4000
NEXT_PUBLIC_CONTROL_API_URL=http://127.0.0.1:4000
GATEWAY_PORT=4080
WEB_PORT=3001
HEALTH_PORT=8080
UMER_PROJECTS_ROOT=C:/laragon/www

# Google Maps API for Opportunity Intelligence / lead discovery
# Required for live Google Places discovery; without it, the system falls
# back to deterministic example businesses (*.example domains). Get a key
# at console.cloud.google.com → Create/select project → Enable "Places API"
# → Credentials → Create API key.
# GOOGLE_MAPS_API_KEY=

# Model Routing — LLM provider (Agent Runtime → Model Routing → LLM Provider)
# lmstudio: local LM Studio server, OpenAI-compatible, no API key required
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen/qwen3-8b
# LLM_API_KEY=                       # only required for hosted openai-compatible providers
LLM_REQUEST_TIMEOUT_MS=60000
# Confirmed live: 2048 was too small for qwen3-8b (reasoning budget), raised to 4096
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
# Agent loop safeguards (Agent Runtime)
# Confirmed live: 8 was enough to start exploring, not enough to reach findings; raised to 20
AGENT_LOOP_MAX_ITERATIONS=20
AGENT_LOOP_TIMEOUT_MS=300000

# Social profile discovery fallback (optional — only used when a business's
# own website has no social links, or no website at all). Free tier: 100
# Google Custom Search queries/day; we cap ourselves at 60/day by default
# (GOOGLE_CSE_DAILY_CAP) to stay well inside it. Leave both unset to disable
# this entirely — the website-link scan still runs and needs no key.
# Setup: console.cloud.google.com → new/existing project → enable "Custom
# Search API" → Credentials → Create API key → GOOGLE_CSE_API_KEY.
# Then programmablesearchengine.google.com → Add → search the entire web →
# copy its Search engine ID → GOOGLE_CSE_CX.
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=
# GOOGLE_CSE_DAILY_CAP=60

# Optional override: UMER_PROJECTS_CATALOG=C:/laragon/www/umer-ai-os/projects/catalog.json
# SEO verify/apply: prefer env URL, else catalog seoLocalUrl / seoBaseUrl
# UMER_SEO_BASE_URL=https://www.cursive-font-generator.com
# UMER_SEO_SKIP_LIGHTHOUSE=1
# UMER_SEO_LIGHTHOUSE_LOCAL=1
# QA verify/apply: catalog qaLocalUrl / qaTestCommand (e.g. school-app → ./vendor/bin/phpunit)
# UMER_QA_SKIP_RUN=1
# UMER_QA_SKIP_PLAYWRIGHT=1
# UMER_QA_RUN_TIMEOUT_MS=600000
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173

# JARVIS — CEO agentic assistant API (apps/jarvis-api)
# Runs on port 3010 by default; control-api forwards /v1/jarvis/* to it
# JARVIS_PORT=3010
# JARVIS_API_URL=http://127.0.0.1:3010
# JARVIS_MEMORY_PERSISTENCE=mysql  # or 'inmemory'
# JARVIS_DEV_PRINCIPAL_ID=ceo
# JARVIS_TENANT_ID=
# JARVIS_TRUST_ACTIONS=read,execute  # comma-separated: read, execute, admin
# JARVIS_ATTENTION_POLL_MS=15000
# JARVIS_DEV_TOKEN=          # static bearer token for dev mode (no OIDC)
# JARVIS_BEARER_TOKEN=       # alternative static token env var
# JARVIS_OIDC_ISSUER=        # OIDC provider issuer URL
# JARVIS_OIDC_AUDIENCE=      # OIDC audience claim
# JARVIS_OIDC_JWKS_URI=      # optional: OIDC JWKS URI override
# JARVIS_OIDC_PRINCIPAL_CLAIM=sub  # claim for principalId
# JARVIS_OIDC_TENANT_CLAIM=  # optional: claim for tenantId
# JARVIS_OIDC_KIND_CLAIM=    # optional: claim for principal kind

# API Security (optional shared tokens for server-to-server calls)
# If unset, services accept requests from localhost without auth (dev-friendly)
# but log a warning. Set these in production to require bearer tokens.
# CONTROL_API_TOKEN=
# JARVIS_API_TOKEN=
