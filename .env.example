# Umer AI OS — local / deploy environment template
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://umer:umer@localhost:5432/umer_ai_os
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_ARTIFACTS=umer-artifacts
S3_FORCE_PATH_STYLE=true

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=umer-ai-os

CONTROL_API_PORT=4000
NEXT_PUBLIC_CONTROL_API_URL=http://127.0.0.1:4000
GATEWAY_PORT=4080
WEB_PORT=3000
HEALTH_PORT=8080
