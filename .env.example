# Umer AI OS — local / deploy environment template
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://umer:umer@localhost:5432/umer_ai_os
REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_ARTIFACTS=umer-artifacts
S3_FORCE_PATH_STYLE=true

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=umer-ai-os

CONTROL_API_PORT=4000
NEXT_PUBLIC_CONTROL_API_URL=http://127.0.0.1:4000
GATEWAY_PORT=4080
WEB_PORT=3000
HEALTH_PORT=8080
UMER_PROJECTS_ROOT=C:/laragon/www
# Optional override: UMER_PROJECTS_CATALOG=C:/laragon/www/umer-ai-os/projects/catalog.json
# SEO verify/apply: prefer env URL, else catalog seoLocalUrl / seoBaseUrl
# UMER_SEO_BASE_URL=https://www.cursive-font-generator.com
# UMER_SEO_SKIP_LIGHTHOUSE=1
# UMER_SEO_LIGHTHOUSE_LOCAL=1
# QA verify/apply: catalog qaLocalUrl / qaTestCommand (e.g. school-app → ./vendor/bin/phpunit)
# UMER_QA_SKIP_RUN=1
# UMER_QA_SKIP_PLAYWRIGHT=1
# UMER_QA_RUN_TIMEOUT_MS=600000
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173
