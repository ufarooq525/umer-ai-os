{
  "name": "@umer/agent-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@umer/contracts": "workspace:*",
    "@umer/message-fabric": "workspace:*",
    "@umer/artifacts": "workspace:*",
    "@umer/memory-access": "workspace:*",
    "@umer/specialist-sdk": "workspace:*",
    "@umer/trust": "workspace:*",
    "@umer/audit": "workspace:*",
    "@umer/model-routing": "workspace:*",
    "@umer/extension": "workspace:*",
    "@umer/registry": "workspace:*",
    "@umer/resilience": "workspace:*",
    "@umer/observability": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
