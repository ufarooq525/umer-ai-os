{
  "name": "@umer/message-fabric",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "cross-env RUN_NATS_INTEGRATION=1 vitest run src/integration.test.ts",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@umer/config": "workspace:*",
    "@umer/contracts": "workspace:*",
    "@umer/observability": "workspace:*",
    "nats": "^2.28.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "cross-env": "^7.0.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
