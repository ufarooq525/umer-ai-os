# syntax=docker/dockerfile:1
# Multi-app Node worker/API image. Build from repo root:
#   docker build -f infra/docker/Dockerfile.worker --build-arg APP_NAME=control-api -t umer-control-api .

ARG APP_NAME=control-api

FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
COPY specialists ./specialists
RUN pnpm install --frozen-lockfile

FROM deps AS build
ARG APP_NAME
RUN pnpm turbo run build --filter=@umer/app-${APP_NAME}...

FROM base AS runner
ARG APP_NAME
ENV NODE_ENV=production
ENV APP_NAME=${APP_NAME}
RUN apk add --no-cache wget
WORKDIR /app
COPY --from=build /app/package.json /app/pnpm-workspace.yaml /app/pnpm-lock.yaml /app/turbo.json /app/tsconfig.base.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/${APP_NAME} ./apps/${APP_NAME}
COPY --from=build /app/specialists ./specialists
WORKDIR /app/apps/${APP_NAME}
EXPOSE 8080
CMD ["node", "dist/main.js"]
