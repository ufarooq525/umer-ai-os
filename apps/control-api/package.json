{
  "name": "@umer/app-control-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@umer/audit": "workspace:*",
    "@umer/config": "workspace:*",
    "@umer/control-plane": "workspace:*",
    "@umer/kernel": "workspace:*",
    "@umer/observability": "workspace:*",
    "@umer/registry": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
