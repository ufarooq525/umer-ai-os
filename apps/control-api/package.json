{
  "name": "@umer/app-control-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "clean": "rimraf dist",
    "watchdog:qa-nightly": "tsx src/scripts/run-qa-nightly-watchdog.ts"
  },
  "dependencies": {
    "@umer/agent-runtime": "workspace:*",
    "@umer/audit": "workspace:*",
    "@umer/config": "workspace:*",
    "@umer/control-plane": "workspace:*",
    "@umer/db": "workspace:*",
    "@umer/event-bus": "workspace:*",
    "@umer/kernel": "workspace:*",
    "@umer/message-fabric": "workspace:*",
    "@umer/observability": "workspace:*",
    "@umer/opportunity-intelligence": "workspace:*",
    "@umer/registry": "workspace:*",
    "@umer/trust": "workspace:*",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
