# Base URL for the existing control API
NEXT_PUBLIC_CONTROL_API_URL=http://127.0.0.1:4000

# Google Places API (New) key. Keep server-side; never prefix with NEXT_PUBLIC_.
# Enable Places API (New) for the Google Cloud project first.
GOOGLE_MAPS_API_KEY=

# Maximum live businesses requested per geography (Google Places caps each search at 20).
OPPORTUNITY_DISCOVERY_LIMIT=20
